spring.application.name=backend

spring.datasource.url=jdbc:postgresql://localhost:5432/<database-name>
spring.datasource.username=<database-user>
spring.datasource.password=<database-password>

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

server.error.include-message=always

jwt.secret=${JWT_SECRET}
jwt.expiration-minutes=${JWT_EXPIRATION_MINUTES}

dor.seed.admin-password=${ADMIN_PASSWORD}
dor.seed.staff-password=${STAFF_PASSWORD}

# optional, the default is http://localhost:4200
dor.cors.allowed-origins=http://localhost:4200
